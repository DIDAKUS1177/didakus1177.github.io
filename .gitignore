# Material de trabajo que NO debe publicarse.
# Contiene las capturas originales sin difuminar (incluida la declaración
# tributaria con datos personales del contribuyente y del contador).
# Las versiones publicables ya están en "Pagina web/public/proyectos/".
Pagina web/Imagenes pendientes/

# Dependencias y artefactos de compilación
node_modules/
dist/
build/
coverage/

# Variables de entorno (claves y URLs privadas)
.env
.env.*
!.env.example

# Sistema operativo / editores
Thumbs.db
desktop.ini
.DS_Store
*.log

# Version privada del CV: incluye los telefonos personales de las referencias
# laborales. NO debe publicarse; se entrega solo a reclutadores concretos.
*_CON_REFERENCIAS.pdf

# Cache de Python de los scripts de _tools/
__pycache__/
*.pyc

# Firebase: cache local y, sobre todo, claves de cuenta de servicio.
# Un JSON de service account en el repo da acceso de despliegue a cualquiera.
.firebase/
firebase-debug.log
firebase-debug.*.log
*-firebase-adminsdk-*.json
serviceAccountKey.json
