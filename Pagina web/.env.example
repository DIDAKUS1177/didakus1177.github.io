# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_CURRICULUM_SHEET_CSV_URL: "Publish to web" CSV link of your Google Sheet
# with columns id, topic, institute, type, name, hours, year, month.
# If empty, the site falls back to the bundled src/data/curriculum.json.
# See GOOGLE_SHEETS_SETUP.md for how to get this URL.
VITE_CURRICULUM_SHEET_CSV_URL=""

# VITE_CONTACT_WEBHOOK_URL: Apps Script Web App URL that appends contact-form
# submissions as rows to a Google Sheet. If empty, the contact form is hidden
# and only the direct WhatsApp/Email/LinkedIn buttons are shown.
# See GOOGLE_SHEETS_SETUP.md for how to create and deploy this.
VITE_CONTACT_WEBHOOK_URL=""
